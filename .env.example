# SQLite file is relative to prisma/schema.prisma
DATABASE_URL="file:../data/kora.db"
SESSION_SECRET=change-this-to-a-long-random-string-32+
ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nebius Token Factory — required for live extraction
# Get $25 credits: https://nebius.com/promo-code  activation code NEBIUS-DEVPOST-GLOBAL26
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional. Grounds named goods against public market pages. Never overwrites a notebook amount.
TAVILY_API_KEY=

# PayPal sandbox — draft invoice after YES. Kora never sends the invoice.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
